# =================================
# AI/ML MODEL CONFIGURATION
# =================================
# OpenAI API (if using GPT model for summarization)
OPENAI_API_KEY=your-openai-api-key-here

# Local Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
SUMMARIZATION_MODEL=facebook/bart-large-cnn

# Model Processing Parameters
CHUNK_SIZE=384
OVERLAP_SIZE=100
RELEVANCE_THRESHOLD=0.25

# Model Cache Directories
MODEL_CACHE_DIR=./model_cache
TORCH_HOME=./torch_cache

# =================================
# FILE PROCESSING CONFIGURATION
# =================================
# File Upload Limits
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
ALLOWED_FILE_TYPES=pdf,doc,docx,txt

# Processing Settings
MAX_CONCURRENT_PROCESSING=3
PROCESSING_TIMEOUT_SECONDS=1800
MAX_PROCESSING_RETRIES=2

# =================================
# LOGGING CONFIGURATION
# =================================
LOG_LEVEL=INFO
LOG_FORMAT=detailed
LOG_FILE=logs/app.log

# Logging Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_FORMAT options: simple, detailed, json

# =================================
# SECURITY CONFIGURATION
# =================================
# API Authentication
REQUIRE_API_KEY=false
API_KEY=05b50cc1fae24872293db1c51806cc24d788ba3eefe9a100dcc0fec23f337251

# JWT Configuration (if implementing user authentication)
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =================================
# RATE LIMITING & PERFORMANCE
# =================================
# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Performance Settings
WORKERS=4
HEARTBEAT_INTERVAL_SECONDS=30

# =================================
# MONITORING & OBSERVABILITY
# =================================
# Error Tracking (Sentry)
SENTRY_DSN=your-sentry-dsn-if-using

# Health Check Settings
HEALTH_CHECK_INTERVAL=300

# =================================
# DEVELOPMENT SETTINGS
# =================================
# Development specific settings
RELOAD=true

# =================================
# FEATURE FLAGS
# =================================
# Enable/Disable specific features
ENABLE_FLASHCARDS=false
ENABLE_SUMMARIZATION=true
ENABLE_FILE_UPLOAD=true
ENABLE_REDIS_CACHE=true

# =================================
# BACKUP CONFIGURATION
# =================================
# Backup settings (if implemented)
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

