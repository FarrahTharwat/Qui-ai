SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFkdXJpYmF0bWtncHB3anV0Y216Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc0OTUyOTA2MiwiZXhwIjoyMDY1MTA1MDYyfQ.pz5jV-svffArk7uy6c2ncj6VXru1vxvrCUQgbd36gFA

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Environment (development, staging, production)
ENVIRONMENT=development

# Application Settings
APP_NAME=QUI.AI Course Service
APP_VERSION=1.0.0
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8001

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Configuration (if using custom JWT)
JWT_SECRET_KEY=6/9uhxyJwjXPRbdiOsOOVBIVyTPKL+T1LnPKV6tXR/aUzfIbnxxYDWheIz6LvbLVaIKfn3KSleqjOkgdM5WDUg==
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Keys for external services
API_KEY_SECRET=your_api_key_for_external_services

# =============================================================================
# MICROSERVICES COMMUNICATION
# =============================================================================
# Content Handler Service URL
CONTENT_HANDLER_URL=http://localhost:8002

# User Service URL (for authentication)
USER_SERVICE_URL=http://localhost:8000

# Recommendation Service URL
RECOMMENDATION_SERVICE_URL=http://localhost:8003

# Notification Service URL
NOTIFICATION_SERVICE_URL=http://localhost:8004

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_redis_password_if_any

# OpenAI API (if using AI features)
OPENAI_API_KEY=your_openai_api_key_here

# AWS Configuration (if using AWS services)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-west-2
AWS_S3_BUCKET=quiai-course-content

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Sentry for error tracking (optional)
SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# CORS & SECURITY
# =============================================================================
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# Allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# =============================================================================
# FILE STORAGE
# =============================================================================
# File upload settings
MAX_FILE_SIZE_MB=10
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# =============================================================================
# EMAIL CONFIGURATION (if needed)
# =============================================================================
# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Cache TTL in seconds
CACHE_TTL=3600
CACHE_PREFIX=quiai_course_

# =============================================================================
# RATE LIMITING
# =============================================================================
# Requests per minute per IP
RATE_LIMIT_PER_MINUTE=100

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Auto-reload on code changes (development only)
AUTO_RELOAD=true

# Show detailed error messages (development only)
SHOW_ERROR_DETAILS=true

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# SSL Configuration (production)
SSL_ENABLED=false
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# Gunicorn workers (production)
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker

# =============================================================================
# TESTING
# =============================================================================
# Test Database URL (optional - for running tests)
TEST_DATABASE_URL=postgresql://postgres:test_password@localhost:5432/quiai_courses_test

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
ENABLE_AI_CONTENT_GENERATION=true
ENABLE_ANALYTICS=true
ENABLE_RECOMMENDATIONS=true
ENABLE_NOTIFICATIONS=true

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================
# Database backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Maintenance mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under maintenance. Please try again later.